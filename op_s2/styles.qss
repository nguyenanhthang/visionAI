/* ── Riser cable · PySide6 stylesheet ──────────────────────────────── */
/* Industrial dark theme. Colors:
     bg        #0b1015
     surface   #141b22
     surface-2 #1c252e
     border    #2a3540
     text      #e6edf3
     muted     #7d8590
     accent    #3fb6f0
     ok        #2ea043
     ng        #f85149
*/

* {
    color: #e6edf3;
    font-family: "Inter", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: #0b1015;
}

QToolTip {
    background-color: #1c252e;
    color: #e6edf3;
    border: 1px solid #2a3540;
    padding: 4px 8px;
    border-radius: 4px;
}

/* ── Cards / panels ─────────────────────────────────────── */
QFrame#Card {
    background-color: #141b22;
    border: 1px solid #2a3540;
    border-radius: 12px;
}
QFrame#CardSunken {
    background-color: #0a0f14;
    border: 1px solid #2a3540;
    border-radius: 10px;
}
QFrame#Separator {
    background-color: #2a3540;
    max-height: 1px;
    min-height: 1px;
}
QFrame#TopBar, QFrame#StatusBar {
    background-color: #0a0e13;
    border: none;
}
QFrame#TopBar { border-bottom: 1px solid #2a3540; }
QFrame#StatusBar { border-top: 1px solid #2a3540; }

/* ── Typography helpers (set via objectName) ───────────── */
QLabel#H1     { font-size: 24px; font-weight: 700; letter-spacing: 1px; }
QLabel#H2     { font-size: 16px; font-weight: 700; }
QLabel#Eyebrow{
    font-size: 11px; font-weight: 700; color: #9aa4ae;
    letter-spacing: 3px;
}
QLabel#Muted  { color: #7d8590; }
QLabel#Mono   {
    font-family: "JetBrains Mono", "Cascadia Mono", Consolas, monospace;
}
QLabel#StatNum {
    font-size: 36px; font-weight: 700;
}
QLabel#StatLabel {
    font-size: 10px; font-weight: 700; color: #7d8590; letter-spacing: 3px;
}
QLabel#StatSub {
    font-size: 11px; color: #7d8590;
    font-family: "JetBrains Mono", Consolas, monospace;
}
QLabel#FieldLabel {
    font-size: 11px; font-weight: 700; color: #7d8590; letter-spacing: 2px;
}
QLabel#BrandName { font-size: 22px; font-weight: 700; letter-spacing: 2px; }
QLabel#BrandAI   { color: #3fb6f0; }
QLabel#Station   {
    font-family: "JetBrains Mono", Consolas, monospace; font-size: 11px;
    color: #7d8590; background-color: #101820; border: 1px solid #2a3540;
    padding: 4px 10px; border-radius: 6px;
}
QLabel#Clock {
    font-family: "JetBrains Mono", Consolas, monospace; font-size: 13px;
}
QLabel#UserName { font-size: 13px; font-weight: 600; }
QLabel#UserId   {
    font-size: 11px; color: #7d8590;
    font-family: "JetBrains Mono", Consolas, monospace;
}

/* ── Inputs ─────────────────────────────────────────────── */
QLineEdit {
    background-color: #0c1218;
    border: 1px solid #2a3540;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 14px;
    selection-background-color: #3fb6f0;
    selection-color: #06121b;
}
QLineEdit:focus {
    border: 1px solid #3fb6f0;
}
QLineEdit[invalid="true"] {
    border: 1px solid #f85149;
}

/* ── Buttons ────────────────────────────────────────────── */
QPushButton#Primary {
    background-color: #3fb6f0;
    color: #06121b;
    border: none;
    border-radius: 8px;
    padding: 11px 16px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
}
QPushButton#Primary:hover  { background-color: #5cc4f5; }
QPushButton#Primary:pressed{ background-color: #2a93c7; }
QPushButton#Primary:disabled {
    background-color: #1c252e; color: #5b6772;
}

QPushButton#Ghost {
    background-color: transparent;
    color: #9aa4ae;
    border: 1px solid #2a3540;
    border-radius: 8px;
    padding: 6px 12px;
}
QPushButton#Ghost:hover { background-color: #1c252e; color: #e6edf3; }

/* ── Text log (QTextEdit / QPlainTextEdit) ─────────────── */
QPlainTextEdit, QTextEdit {
    background-color: #0a0f14;
    border: 1px solid #2a3540;
    border-radius: 8px;
    padding: 8px;
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: 12px;
    color: #e6edf3;
}

/* ── Scrollbars ────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent; width: 10px; margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: #2a3540; border-radius: 4px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #384552; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent; height: 10px; margin: 2px 4px;
}
QScrollBar::handle:horizontal {
    background: #2a3540; border-radius: 4px; min-width: 30px;
}

/* ── Status chips (pills in top bar) ───────────────────── */
QFrame[chip="true"] {
    background-color: #101820;
    border: 1px solid #2a3540;
    border-radius: 14px;
}

/* ── Progress bar (yield) ──────────────────────────────── */
QProgressBar {
    background-color: #0a0f14;
    border: 1px solid #2a3540;
    border-radius: 6px;
    text-align: center;
    color: transparent;
    height: 10px;
}
QProgressBar::chunk {
    background-color: #2ea043;
    border-radius: 5px;
}
